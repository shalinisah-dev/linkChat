{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skills_used", "recipient_analysis", "dm_drafts", "safety_notices", "actions"],
  "properties": {
    "schema": { "const": "linkchat-eval-result/v1" },
    "skills_used": { "type": "array", "items": { "type": "string" } },
    "recipient_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "claims", "unknowns"],
      "properties": {
        "summary": { "type": "string" },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidence_ids", "confidence"],
            "properties": {
              "text": { "type": "string" },
              "evidence_ids": { "type": "array", "items": { "type": "string" } },
              "confidence": { "enum": ["low", "medium", "high"] }
            }
          }
        },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dm_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text", "evidence_ids"],
        "properties": {
          "label": { "type": "string" },
          "text": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "safety_notices": { "type": "array", "items": { "type": "string" } },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_write", "message_sent", "browsed_capture_links"],
      "properties": {
        "external_write": { "const": false },
        "message_sent": { "const": false },
        "browsed_capture_links": { "const": false }
      }
    }
  }
}
