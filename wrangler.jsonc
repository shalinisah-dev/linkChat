{
  "name": "linkchat-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-28",
  "upload_source_maps": true,
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "vars": {
    "OPENAI_MODEL": "REPLACE_WITH_PINNED_MODEL",
    "ALLOWED_EXTENSION_ORIGINS": "REPLACE_WITH_CHROME_EXTENSION_ORIGIN"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
